<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body>
<%- include('nav') %>

<h1>Contact Us</h1>
<form action="/contact" method="post">
  <div style="margin:10px 0;">
    <label>Name:</label>
    <input type="text" name="name" required style="padding:6px; width:250px;">
  </div>
  <div style="margin:10px 0;">
    <label>Email:</label>
    <input type="email" name="email" required style="padding:6px; width:250px;">
  </div>
  <div style="margin:10px 0;">
    <label>Message:</label><br>
    <textarea name="message" rows="5" cols="35" style="padding:6px;"></textarea>
  </div>
  <button type="submit" style="padding:8px 16px; cursor:pointer;">Send Message</button>
</form>

</body>
</html>
